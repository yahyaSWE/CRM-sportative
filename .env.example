# Miljövariabler för LeadFlow CRM i produktion (Render → Environment).
# render.yaml sätter NODE_ENV, NODE_VERSION, DATA_DIR och APP_SECRET automatiskt.
# Den här filen är bara en mall – inga riktiga värden här.

# Slår på produktionsläge: ingen demodata, säkra cookies, dagliga säkerhetskopior.
NODE_ENV=production

# Din e-postadress. Bara den får skapa det första administratörskontot.
ADMIN_EMAIL=du@dittforetag.se

# Krypteringsnyckel: 64 hextecken eller minst 32 slumpade tecken (Render genererar den).
# Byt ALDRIG när appen väl används – sparade lösenord och tokens blir då oläsliga.
APP_SECRET=

# Var databasen och säkerhetskopiorna sparas = diskens monteringspunkt.
DATA_DIR=/var/data

# Den publika adressen (utan / på slutet). Används för webhooks, Google-inloggning och offertlänkar.
PUBLIC_URL=https://crm.dittforetag.se

# Antal proxysteg att lita på för klientens IP (standard 1). På Render: 2 (Cloudflare + Render). Se DEPLOY.md.
TRUST_PROXY=2

# Valfritt: antal dagliga säkerhetskopior som sparas (standard 14).
# BACKUP_KEEP=14
