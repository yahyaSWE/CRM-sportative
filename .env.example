# Miljövariabler för LeadFlow CRM i produktion (Railway → Variables).
# Inga riktiga värden här – den här filen är bara en mall.

# Slår på produktionsläge: ingen demodata, säkra cookies, dagliga säkerhetskopior.
NODE_ENV=production

# Din e-postadress. Bara den får skapa det första administratörskontot.
ADMIN_EMAIL=du@dittforetag.se

# Krypteringsnyckel, 64 hextecken. Skapa med:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Byt ALDRIG när appen väl används – sparade lösenord och tokens blir då oläsliga.
APP_SECRET=

# Var databasen och säkerhetskopiorna sparas. Ska peka på Railway-volymens monteringspunkt.
DATA_DIR=/data

# Den publika adressen (utan / på slutet). Används för webhooks, Google-inloggning och offertlänkar.
PUBLIC_URL=https://crm.dittforetag.se

# Valfritt: antal dagliga säkerhetskopior som sparas (standard 14).
# BACKUP_KEEP=14
